{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InvoiceHub",
  "version": "0.3.0-alpha.2",
  "identifier": "com.invoicehub.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:8766",
    "frontendDist": "../src-tauri/boot"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": ["no-webview-ipc"],
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "resources": {
      ".public-preview-staging/invoice-hub-core": "invoice-hub-core",
      ".public-preview-staging/python": "python",
      ".public-preview-staging/invoice-hub-public-preview-launcher.sh": "invoice-hub-public-preview-launcher.sh",
      ".public-preview-staging/invoicehub-desktop-host.json": "invoicehub-desktop-host.json"
    },
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
